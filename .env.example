# Copy to .env.local and fill in. Never commit real values.

# Clash of Clans API key from developer.clashofclans.com, created for the
# RoyaleAPI proxy IP (45.79.218.79).
COC_API_TOKEN=

# Proxy base URL. Swap for your own VPS proxy later.
COC_API_BASE_URL=https://cocproxy.royaleapi.dev/v1

# Public address of the site, for canonical URLs, link previews, robots.txt and
# the sitemap. Optional on Vercel (falls back to the production domain).
# SITE_URL=https://warroomstats.example

# Upstash Redis for per-IP rate limiting. Leave empty to disable locally.
# Required for Vercel production deploys: the build fails without it. Vercel's
# Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development without a token: serve fixtures from src/lib/coc/fixtures.
# Ignored in production builds.
# COC_API_MOCK=1
