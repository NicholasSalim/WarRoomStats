# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets: every env file except the template (which holds no real values)
.env*
!.env.example
*.key
*.p12
*.pfx

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP output (screenshots and snapshots of live player data)
.playwright-mcp/
# Playwright test output
/test-results/
/playwright-report/

# Local tooling output, not needed to build or deploy
/graphify-out/
/.claude/
*.log

# Local-only scripts that call the live API with your token (debugging and
# ID research). The deploy doesn't use them.
/scripts/inspect-player.mjs
/scripts/probe-*.mjs

# Editors and OS files
/.vscode/
/.idea/
Thumbs.db
desktop.ini

# Local-only docs: agent instructions (next dev rewrites AGENTS.md) and the
# design decisions record. Kept on the dev machine, not in the repo.
/AGENTS.md
/docs/DECISIONS.md
